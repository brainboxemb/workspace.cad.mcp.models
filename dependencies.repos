# vcs2l: exact external toolchain release tags used by this workspace template.
# Update these release tags only together with the MCP/Forge compatibility contract.
repositories:
  mcp:
    type: git
    url: https://github.com/brainboxemb/tool.cad.mcp.forge.git
    version: v0.0.2

  forge:
    type: git
    url: https://github.com/brainboxemb/lib.py.solidcraft.forge.git
    version: v0.25.0
